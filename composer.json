{
    "name": "verdigado/groupfolder_tags",
    "type": "project",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Jonathan Treffler",
			"email": "mail@jonathan-treffler.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "OCA\\GroupfolderTags\\": "lib/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "autoloader-suffix": "GroupfolderTags",
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
	},
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "target-directory": "vendor-bin",
            "forward-command": true
        }
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9"
    }
}
