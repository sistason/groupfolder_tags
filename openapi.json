{
    "openapi": "3.0.3",
    "info": {
        "title": "groupfolder_tags",
        "version": "0.0.1",
        "description": "Allows admins to attach key-value tags to groupfolders",
        "license": {
            "name": "agpl"
        }
    },
    "components": {
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            },
            "bearer_auth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "OCSMeta": {
                "type": "object",
                "required": [
                    "status",
                    "statuscode"
                ],
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "statuscode": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "totalitems": {
                        "type": "string"
                    },
                    "itemsperpage": {
                        "type": "string"
                    }
                }
            },
            "Tag": {
                "type": "object",
                "required": [
                    "groupFolderId",
                    "tagKey",
                    "tagValue",
                    "lastUpdatedTimestamp"
                ],
                "properties": {
                    "groupFolderId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "tagKey": {
                        "type": "string"
                    },
                    "tagValue": {
                        "type": "string"
                    },
                    "lastUpdatedTimestamp": {
                        "type": "integer",
                        "format": "int64"
                    }
                }
            }
        }
    },
    "paths": {
        "/ocs/v2.php/apps/groupfolder_tags/api/v1/tags": {
            "get": {
                "operationId": "api-index",
                "summary": "Get all tags optionally filtered by tagKey, tagValue and groupFolderId",
                "description": "This endpoint requires admin access",
                "tags": [
                    "api"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "tagKey",
                        "in": "query",
                        "description": "filter results to tags with this key",
                        "schema": {
                            "type": "string",
                            "nullable": true,
                            "default": null
                        }
                    },
                    {
                        "name": "tagValue",
                        "in": "query",
                        "description": "filter results to tags with this value",
                        "schema": {
                            "type": "string",
                            "nullable": true,
                            "default": null
                        }
                    },
                    {
                        "name": "groupFolderId",
                        "in": "query",
                        "description": "filter results to tags attached to this groupfolder",
                        "schema": {
                            "type": "integer",
                            "format": "int64",
                            "nullable": true,
                            "default": null
                        }
                    },
                    {
                        "name": "OCS-APIRequest",
                        "in": "header",
                        "description": "Required to be true for the API request to pass",
                        "required": true,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "0 or multiple matching tags returned",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "type": "object",
                                                    "required": [
                                                        "tags"
                                                    ],
                                                    "properties": {
                                                        "tags": {
                                                            "type": "array",
                                                            "items": {
                                                                "$ref": "#/components/schemas/Tag"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
